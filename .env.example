# Gemini API Key (Google AI Studio)
API_KEY=tu-api-key-gemini-aqui

# Respaldo opcional si API_KEY no está definida
API_KEY_LLM=

# Token de acceso al endpoint /api/chat (genera uno aleatorio y seguro)
# Si no se define, el chat funciona sin token (solo recomendado en desarrollo local)
CHAT_API_TOKEN=genera-un-token-seguro-aqui

# Orígenes permitidos para CORS (separados por coma, sin barra final)
# En producción, por defecto solo se permite https://mecani.onrender.com
ALLOWED_ORIGINS=https://mecani.onrender.com

# Entorno (production en Render)
NODE_ENV=production
